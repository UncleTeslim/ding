---
const basePath = import.meta.env.BASE_URL || "/";

const { currentPath = "" } = Astro.props;

function stripBase(p: string): string {
  return p.replace(basePath, "/");
}

const cleanPath = stripBase(currentPath).replace(/\/$/, "");

const sections = [
  {
    label: "Getting Started",
    items: [
      { label: "Introduction", href: `${basePath}docs/introduction` },
      { label: "Quick Start", href: `${basePath}docs/quick-start` },
    ],
  },
  {
    label: "Usage",
    items: [
      { label: "Embedding the Widget", href: `${basePath}docs/embedding` },
      { label: "Configuration", href: `${basePath}docs/configuration` },
      { label: "API Reference", href: `${basePath}docs/api-reference` },
    ],
  },
  {
    label: "Operations",
    items: [
      { label: "Self-Hosting", href: `${basePath}docs/self-hosting` },
      { label: "Contributing", href: `${basePath}docs/contributing` },
    ],
  },
];
---

<nav class="doc-sidebar">
  <div class="sidebar-inner">
    {sections.map((section) => (
      <div class="sidebar-group">
        <h4 class="sidebar-group-label">{section.label}</h4>
        <ul>
          {section.items.map((item) => {
            const itemClean = stripBase(item.href).replace(/\/$/, "");
            const isActive = cleanPath === itemClean;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={{ "sidebar-link": true, active: isActive }}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>

<style>
  .doc-sidebar {
    width: 240px;
    flex-shrink: 0;
    padding: 32px 0;
    border-right: 1px solid var(--border);
    height: calc(100vh - 64px);
    position: sticky;
    top: 64px;
    overflow-y: auto;
  }
  .sidebar-inner { padding: 0 16px; }
  .sidebar-group { margin-bottom: 24px; }
  .sidebar-group-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--muted);
    margin-bottom: 8px;
    padding: 0 12px;
  }
  .sidebar-group ul { list-style: none; }
  .sidebar-group li { margin: 2px 0; }
  .sidebar-link {
    display: block;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none !important;
    transition: background 150ms;
  }
  .sidebar-link:hover { background: var(--bg-alt); }
  .sidebar-link.active {
    background: #ede9fe;
    color: #5b21b6;
    font-weight: 600;
  }
  @media (max-width: 768px) {
    .doc-sidebar { display: none; }
  }
</style>
