---
const repoUrl = "https://github.com/UncleTeslim/ding";
---

<section id="embed" class="embed-section">
  <div class="container">
    <div class="embed-grid">
      <div class="embed-text">
        <span class="tag">Get started</span>
        <h2>Add Ding to your app in 30 seconds</h2>
        <p class="embed-sub">Paste this into your HTML. The widget initialises automatically, loads asynchronously, and never blocks page render.</p>
        <div class="embed-features">
          <div class="embed-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <span>No build step required</span>
          </div>
          <div class="embed-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <span>Works in any framework</span>
          </div>
          <div class="embed-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <span>Configure via data attributes</span>
          </div>
        </div>
        <div class="embed-cta">
          <a href={repoUrl} target="_blank" class="btn btn-dark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.96c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.74 1.27 3.41.97.11-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.15c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
            Clone the repo
          </a>
          <a href={repoUrl} target="_blank" class="btn btn-ghost">Star on GitHub</a>
        </div>
      </div>
      <div class="embed-code">
        <div class="code-header">
          <div class="code-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="code-label">your-app.html</span>
        </div>
        <pre><code><span class="line">&lt;<span class="tag-name">script</span></span>
<span class="line">  <span class="attr">src</span>=<span class="str">"https://your-ding.com/widget.js"</span></span>
<span class="line">  <span class="attr">data-position</span>=<span class="str">"bottom-right"</span></span>
<span class="line">  <span class="attr">data-color</span>=<span class="str">"#6366f1"</span></span>
<span class="line">  <span class="attr">data-trigger</span>=<span class="str">"both"</span></span>
<span class="line">  <span class="kw">async</span></span>
<span class="line">&gt;&lt;/<span class="tag-name">script</span>&gt;</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .embed-section { padding: 80px 0; background: var(--bg); }
  .embed-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .embed-text h2 {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
    margin: 16px 0 16px;
  }
  .embed-sub { font-size: 18px; color: var(--muted); margin-bottom: 24px; line-height: 1.6; }
  .embed-features { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
  .embed-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
  }
  .embed-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .embed-code {
    background: #0f172a;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(15,23,42,0.15);
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #1e293b;
  }
  .code-dots { display: flex; gap: 6px; }
  .code-dots span {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .code-dots span:nth-child(1) { background: #ef4444; }
  .code-dots span:nth-child(2) { background: #f59e0b; }
  .code-dots span:nth-child(3) { background: #22c55e; }
  .code-label { font-size: 13px; color: #94a3b8; font-family: var(--mono); }
  pre { margin: 0; padding: 24px 20px; overflow-x: auto; }
  code {
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.7;
    color: #cbd5e1;
  }
  .line { display: block; }
  .tag-name { color: #f472b6; }
  .attr { color: #7dd3fc; }
  .str { color: #86efac; }
  .kw { color: #fbbf24; }

  @media (max-width: 768px) {
    .embed-grid { grid-template-columns: 1fr; gap: 32px; }
    .embed-text h2 { font-size: 28px; }
  }
</style>