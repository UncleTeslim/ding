---
const repoUrl = "https://github.com/anomalyco/ding";
---

<section class="hero">
  <div class="container">
    <div class="hero-badge">
      <span class="tag">Open source</span>
      <span>Self-hosted alternative to Beamer &amp; Headway</span>
    </div>
    <h1>Changelog widget for your product.<br /><span>Self-hosted. Open source.</span></h1>
    <p class="hero-sub">
      Ding gives you a private admin dashboard for publishing product updates,
      and a small in-app widget for users to see what changed. It runs on your
      own infrastructure. No third-party scripts, no cookies, no monthly bill.
    </p>
    <div class="hero-cta">
      <a href={repoUrl} target="_blank" class="btn btn-dark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.96c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.74 1.27 3.41.97.11-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.15c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
        Star on GitHub
      </a>
      <a href="/demo/" target="_blank" class="btn btn-ghost">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        View live demo
      </a>
    </div>

    <div class="hero-preview">
      <div class="preview-browser">
        <div class="preview-bar">
          <span></span><span></span><span></span>
          <div class="preview-url">yourapp.com/dashboard</div>
        </div>
        <div class="preview-body">
          <div class="preview-shot">
            <div class="shot-sidebar">
              <div class="shot-logo">
                <svg width="20" height="20" viewBox="0 0 48 48" fill="none">
                  <rect x="4" y="4" width="40" height="40" rx="10" fill="#1e293b"/>
                  <path d="M17 28.5V21a7 7 0 0 1 14 0v7.5l3 4.5H14l3-4.5Z" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>
                  <path d="M21 36a3.5 3.5 0 0 0 6 0" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
                  <circle cx="34" cy="14" r="5" fill="#6366f1" stroke="#fff" stroke-width="2"/>
                </svg>
              </div>
              <div class="shot-nav-items">
                <div class="shot-nav-item active"></div>
                <div class="shot-nav-item"></div>
                <div class="shot-nav-item"></div>
                <div class="shot-nav-item"></div>
              </div>
            </div>
            <div class="shot-content">
              <div class="shot-stats">
                <div class="shot-stat"></div>
                <div class="shot-stat"></div>
                <div class="shot-stat"></div>
                <div class="shot-stat"></div>
              </div>
              <div class="shot-table">
                <div class="shot-row"></div>
                <div class="shot-row"></div>
                <div class="shot-row"></div>
                <div class="shot-row"></div>
              </div>
            </div>
          </div>
          <div class="preview-bell">
            <div class="bell-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 7h18s-3 0-3-7"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              </svg>
              <span class="bell-badge">2</span>
            </div>
            <div class="bell-tooltip">Click the bell to see what's new</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 80px 0 60px;
    background: linear-gradient(180deg, #faf8ff 0%, #ffffff 100%);
    overflow: hidden;
  }
  .hero-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 24px;
  }
  h1 {
    font-size: 52px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
  }
  .hero h1 span {
    color: var(--muted);
    font-weight: 700;
  }
  .hero-sub {
    font-size: 19px;
    color: var(--muted);
    max-width: 580px;
    margin-bottom: 36px;
    line-height: 1.6;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }

  /* Browser preview */
  .hero-preview { max-width: 900px; margin: 0 auto; }
  .preview-browser {
    background: var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.15);
  }
  .preview-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: #f1f5f9;
  }
  .preview-bar span {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: #cbd5e1;
  }
  .preview-bar span:nth-child(1) { background: #ef4444; }
  .preview-bar span:nth-child(2) { background: #f59e0b; }
  .preview-bar span:nth-child(3) { background: #22c55e; }
  .preview-url {
    flex: 1;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    background: #fff;
    border-radius: 6px;
    padding: 4px 12px;
    margin-left: 8px;
    font-family: var(--mono);
  }
  .preview-body { position: relative; background: #f8fafc; height: 360px; }
  .preview-shot { display: flex; height: 100%; }

  .shot-sidebar {
    width: 180px;
    background: #0f172a;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .shot-logo {
    width: 28px; height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shot-nav-items { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
  .shot-nav-item {
    height: 28px;
    border-radius: 6px;
    background: rgba(148,163,184,0.15);
  }
  .shot-nav-item.active { background: rgba(99,102,241,0.3); }

  .shot-content { flex: 1; padding: 20px; }
  .shot-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  .shot-stat { height: 64px; background: #fff; border-radius: 8px; border: 1px solid var(--border); }
  .shot-table { display: flex; flex-direction: column; gap: 8px; }
  .shot-row { height: 40px; background: #fff; border-radius: 8px; border: 1px solid var(--border); }

  .preview-bell {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .bell-icon {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: 0 12px 30px rgba(15,23,42,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    position: relative;
  }
  .bell-badge {
    position: absolute;
    top: -4px; right: -4px;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: #ef4444;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bell-tooltip {
    background: #0f172a;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 8px;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    h1 { font-size: 36px; }
    .hero-sub { font-size: 17px; }
    .shot-sidebar { width: 48px; }
    .shot-nav-items { display: none; }
    .shot-stats { grid-template-columns: repeat(2, 1fr); }
    .shot-content { padding: 12px; }
    .preview-body { height: 280px; }
  }
</style>