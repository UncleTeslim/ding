---
const year = new Date().getFullYear();
const repoUrl = "https://github.com/anomalyco/ding";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <svg width="24" height="24" viewBox="0 0 48 48" fill="none">
            <rect x="4" y="4" width="40" height="40" rx="10" fill="#0f172a"/>
            <path d="M17 28.5V21a7 7 0 0 1 14 0v7.5l3 4.5H14l3-4.5Z" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>
            <path d="M21 36a3.5 3.5 0 0 0 6 0" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
            <circle cx="34" cy="14" r="5" fill="#6366f1" stroke="#fff" stroke-width="2"/>
          </svg>
          <span>Ding</span>
        </a>
        <p>Self-hosted changelog widget for your web app.</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Product</h4>
          <a href="/#features">Features</a>
          <a href="/#how-it-works">How it works</a>
          <a href="/#embed">Embed code</a>
          <a href="/demo/" target="_blank">Live demo</a>
        </div>
        <div class="footer-col">
          <h4>Resources</h4>
          <a href={repoUrl} target="_blank">GitHub</a>
          <a href={repoUrl + "/blob/main/README.md"} target="_blank">Documentation</a>
          <a href={repoUrl + "/blob/main/docs/ROADMAP.md"} target="_blank">Roadmap</a>
          <a href={repoUrl + "/blob/main/docs/DEPLOYMENT.md"} target="_blank">Deployment</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>MIT License. {year} Ding.</p>
      <a href={repoUrl} target="_blank" class="footer-gh">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.96c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.74 1.27 3.41.97.11-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.15c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0f172a;
    color: #94a3b8;
    padding: 64px 0 32px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 800;
    color: #fff;
    text-decoration: none !important;
    margin-bottom: 12px;
  }
  .footer-brand p { font-size: 14px; max-width: 280px; }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .footer-col { display: flex; flex-direction: column; gap: 10px; }
  .footer-col h4 {
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .footer-col a {
    font-size: 14px;
    color: #94a3b8;
    text-decoration: none !important;
    transition: color 150ms;
  }
  .footer-col a:hover { color: #fff; }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid #1e293b;
  }
  .footer-bottom p { font-size: 13px; }
  .footer-gh { color: #94a3b8; }
  .footer-gh:hover { color: #fff; }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>