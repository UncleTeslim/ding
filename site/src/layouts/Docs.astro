---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DocSidebar from "../components/DocSidebar.astro";

const {
  title = "Ding Docs",
  description = "Documentation for the Ding self-hosted changelog widget",
} = Astro.props;

const basePath = import.meta.env.BASE_URL || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · Ding Docs</title>
  </head>
  <body>
    <Header />
    <div class="doc-layout">
      <DocSidebar currentPath={Astro.url.pathname} />
      <main class="doc-content">
        <article class="doc-article">
          <slot />
        </article>
      </main>
    </div>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --bg: #ffffff;
    --bg-alt: #f8fafc;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --dark: #0f172a;
    --dark-surface: #1e293b;
    --radius: 12px;
    --font: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SF Mono", "Cascadia Mono", "Roboto Mono", Menlo, monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--primary); }
  a:hover { text-decoration: underline; }

  .tag {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    background: #ede9fe;
    color: #5b21b6;
    letter-spacing: 0.3px;
  }

  .doc-layout {
    display: flex;
    min-height: calc(100vh - 64px - 200px);
  }

  .doc-content {
    flex: 1;
    max-width: 800px;
    padding: 48px 48px 96px;
    margin: 0 auto;
  }

  .doc-article h1 {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .doc-article h2 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin: 40px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .doc-article h3 {
    font-size: 20px;
    font-weight: 600;
    margin: 28px 0 8px;
  }

  .doc-article p {
    margin: 16px 0;
    color: var(--text);
    line-height: 1.7;
  }

  .doc-article ul, .doc-article ol {
    margin: 12px 0;
    padding-left: 24px;
  }

  .doc-article li {
    margin: 6px 0;
    line-height: 1.6;
  }

  .doc-article a { color: var(--primary); font-weight: 500; }

  .doc-article pre {
    background: #0f172a;
    color: #e2e8f0;
    border-radius: 10px;
    padding: 20px 24px;
    overflow-x: auto;
    margin: 20px 0;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
  }

  .doc-article code {
    font-family: var(--mono);
    font-size: 13.5px;
    background: var(--bg-alt);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .doc-article pre code {
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    font-size: 14px;
  }

  .doc-article table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }

  .doc-article th {
    text-align: left;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    padding: 10px 12px;
    border-bottom: 2px solid var(--border);
  }

  .doc-article td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }

  .doc-article tr:last-child td { border-bottom: none; }

  .doc-article blockquote {
    border-left: 3px solid var(--primary);
    padding: 12px 20px;
    margin: 20px 0;
    background: var(--bg-alt);
    border-radius: 0 8px 8px 0;
    color: var(--muted);
  }

  .doc-article hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 40px 0;
  }

  .doc-article img { max-width: 100%; border-radius: 8px; }

  @media (max-width: 768px) {
    .doc-content {
      padding: 24px 20px 64px;
    }
    .doc-article h1 { font-size: 30px; }
    .doc-article h2 { font-size: 22px; }
  }
</style>
